# template mode needs no key and covers a fixed set of question shapes.
SCHEMAMIND_GEN_MODE=template

# Switch to mistral for real text-to-SQL, with a free key from console.mistral.ai
# (the evaluation, python -m eval.run_eval, uses Mistral whatever the mode here).
# SCHEMAMIND_GEN_MODE=mistral
# MISTRAL_API_KEY=
# Any model your plan allows (see the Limits page of Mistral's admin console).
# MISTRAL_MODEL=codestral-2508

# The free plan limits requests per second: calls are spaced this many seconds
# apart, and a rate limit (429) or server error is retried this many times.
# SCHEMAMIND_LLM_MIN_INTERVAL=1.1
# SCHEMAMIND_LLM_RETRIES=4

SCHEMAMIND_TOP_K_TABLES=3
SCHEMAMIND_MAX_REPAIR=2
